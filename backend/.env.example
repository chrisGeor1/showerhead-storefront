# Copy to .env and adjust for local dev. Docker Compose supplies its own
# values for the containerized backend (see ../docker-compose.yml).

NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:5175
ADMIN_ORIGIN=http://localhost:5174

DATABASE_URL=postgresql://vortex:vortex@localhost:5435/vortex

JWT_SECRET=change-this-to-a-random-32-plus-character-string
JWT_TTL=7d

# mock (default, no external calls) or paystack (requires the secret key below)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# local (writes to STORAGE_LOCAL_DIR, served at /uploads) or minio
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000/vortex-media
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vortex-media
STORAGE_ACCESS_KEY=vortex
STORAGE_SECRET_KEY=vortex-secret
STORAGE_LOCAL_DIR=uploads

# Seeded on first `npm run db:seed` — change the password afterward from the
# admin dashboard once that's supported, or reset directly in the DB.
ADMIN_SEED_EMAIL=admin@vortex.local
ADMIN_SEED_PASSWORD=change-me-please
